// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  password_hash   String
  washingPrograms Washing_Program[]
  mieleToken      Miele_Token?
  subscriptions   PushSubscription[]
  createdAt       DateTime @default(now())
}

model Weather_Forecast {
  id          Int      @id @default(autoincrement())
  time        DateTime @unique @db.Timestamptz(3) // L'heure précise de la prévision
  temp        Float
  SolarRay    Float?
  updatedAt   DateTime @updatedAt
}

model Solar_Data {
  id            Int       @id @default(autoincrement())
  hour          DateTime  @default(now()) @db.Timestamptz(3)
  Watts         Int
  total         Int
}

model Washing_Program {
  id            Int       @id @default(autoincrement())
  deviceId      String
  type          Int
  name          String
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  startAt       DateTime 
  finished      String    
  authorId      Int
  author        User      @relation(fields: [authorId], references: [id])
  notifs        PushNotif[]
}

model Miele_Token {
  id           Int      @id @default(autoincrement())
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Champs issus de l'objet web-push
  endpoint  String   @unique // L'endpoint sert de clé unique pour éviter les doublons
  p256dh    String
  auth      String
  
  createdAt DateTime @default(now())
}

model PushNotif {
  id            Int             @id @default(autoincrement())
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  sendAt        DateTime        @default(now()) @db.Timestamptz(3)
  type          Int
  programId     Int       
  program       Washing_Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}